# Copy to .env for a new checkout. Use your own project values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase dashboard > Connect > Direct connection or Session pooler (port 5432).
# Use the DATABASE password, not an API key. URL-encode special password characters.
DATABASE_URL=postgresql://postgres:your-url-encoded-password@db.your-project.supabase.co:5432/postgres

# Safe default is production: HTTPS and Secure, host-only session cookies.
APP_ENV=production
ALLOWED_ORIGINS=["https://your-frontend.example"]
ALLOWED_HOSTS=["your-api.example"]

# Optional: set only locally for the initial seed; never commit real passwords.
SEED_SUPERADMIN_PASSWORD=
# Optional initial identity; existing seeded profiles are never overwritten.
SEED_SUPERADMIN_FULL_NAME=Superadmin
SEED_SUPERADMIN_EMAIL=superadmin@legacy.invalid

# Optional private receipt directory; default is backend/private/expense_receipts.
# PRIVATE_RECEIPT_DIR=
